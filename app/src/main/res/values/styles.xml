<resources>

    <!-- Estilo personalizado para ActionBar em tela cheia -->
    <style name="Widget.Theme.Ifrspoa.ActionBar.Fullscreen" parent="Widget.AppCompat.ActionBar">
        <!-- Cor de fundo definida como um overlay preto -->
        <item name="android:background">@color/black_overlay</item>
    </style>

    <!-- Estilo personalizado para ButtonBar em tela cheia -->
    <style name="Widget.Theme.Ifrspoa.ButtonBar.Fullscreen" parent="Widget.AppCompat.ButtonBar">
        <!-- Cor de fundo definida como um overlay preto -->
        <item name="android:background">@color/black_overlay</item>
        <!-- Estilo de barra de botões herdado dos atributos de sistema -->
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>
    <!-- Tema para SplashActivity -->
    <style name="Theme.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Cor da barra de status -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar">true</item> <!-- Ajuste o texto da barra para escuro/claro, se necessário -->
    </style>
</resources>

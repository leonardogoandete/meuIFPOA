<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Imagem de perfil -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPerfil"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ifrs_poa_logo"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorPrimary"
        app:shapeAppearanceOverlay="@style/Circular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LinearLayout para perfil -->
    <LinearLayout
        android:id="@+id/containerPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Nome -->
        <LinearLayout
            android:id="@+id/linearLayoutNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_pessoa" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/txtTituloNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="@string/txtViewTituloNome" />

                <TextView
                    android:id="@+id/txtViewValorNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Leonardo Dias Goandete" />
            </LinearLayout>
        </LinearLayout>

        <!-- Matrícula -->
        <LinearLayout
            android:id="@+id/linearLayoutMatricula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_matricula" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/txtTituloMatricula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="@string/txtViewTituloMatricula" />

                <TextView
                    android:id="@+id/txtViewValorMatricula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2020007666" />
            </LinearLayout>
        </LinearLayout>

        <!-- Curso -->
        <LinearLayout
            android:id="@+id/linearLayoutCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_curso" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/txtTituloCurso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="@string/txtViewTituloCurso" />

                <TextView
                    android:id="@+id/txtViewValorCurso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="TECNOLOGIA EM SISTEMAS PARA INTERNET/DE-POA" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nível -->
        <LinearLayout
            android:id="@+id/linearLayoutNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_nivel" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/txtTituloNivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="@string/txtViewTituloNivel" />

                <TextView
                    android:id="@+id/txtViewValorNivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Graduação" />
            </LinearLayout>
        </LinearLayout>

        <!-- Situação -->
        <LinearLayout
            android:id="@+id/linearLayoutSituacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_status" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/txtTituloSituacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="@string/txtViewTituloSituacao" />

                <TextView
                    android:id="@+id/txtViewValorSituacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Ativo" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ingresso -->
        <LinearLayout
            android:id="@+id/linearLayoutIngresso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_ingresso" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/txtTituloIngresso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="@string/txtViewTituloIngresso" />

                <TextView
                    android:id="@+id/txtViewValorIngresso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2020.1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Botão de sair -->
    <Button
        android:id="@+id/btnSairPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/btnSairPerfilText"
        app:layout_constraintTop_toBottomOf="@id/containerPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ProgressBar de carregamento -->
    <LinearLayout
        android:id="@+id/containerProgressBarPerfil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBarPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/colorPrimary" />

        <TextView
            android:id="@+id/txtCarregandoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/msgSincronizando"
            android:textSize="18sp"
            android:gravity="center" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

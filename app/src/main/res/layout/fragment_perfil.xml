<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layout_marginBottom="68dp"
    >

    <ImageView
        android:id="@+id/imgPerfil"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/ifrs_poa_logo"
        app:shapeAppearanceOverlay="@style/Circular"
        />

    <LinearLayout
        android:id="@+id/linearLayoutNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@+id/imgPerfil"
        tools:layout_editor_absoluteX="0dp">

        <ImageView
            android:layout_width="48sp"
            android:layout_height="48sp"
            android:src="@drawable/ic_pessoa"
            tools:src="@drawable/ic_pessoa" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloNome" />

            <TextView
                android:id="@+id/txtViewValorNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Leonardo Dias Goandete" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutMatricula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutNome"
        tools:layout_editor_absoluteX="0dp">

        <ImageView
            android:layout_width="48sp"
            android:layout_height="48sp"
            android:src="@drawable/ic_matricula"
            tools:src="@drawable/ic_matricula" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloMatricula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloMatricula" />

            <TextView
                android:id="@+id/txtViewValorMatricula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2020007666" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutCurso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutMatricula"
        tools:layout_editor_absoluteX="0dp">

        <ImageView
            android:layout_width="48sp"
            android:layout_height="48sp"
            android:src="@drawable/ic_curso"
            tools:src="@drawable/ic_curso" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloCurso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloCurso" />

            <TextView
                android:id="@+id/txtViewValorCurso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="TECNOLOGIA EM SISTEMAS PARA INTERNET/DE-POA - Porto Alegre - TECNOLÓGICO - MN" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutNivel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutCurso"
        tools:layout_editor_absoluteX="0dp">

        <ImageView
            android:layout_width="48sp"
            android:layout_height="48sp"
            android:src="@drawable/ic_nivel"
            tools:src="@drawable/ic_nivel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloNivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloNivel" />

            <TextView
                android:id="@+id/txtViewValorNivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Graduação" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutSituacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutNivel"
        tools:layout_editor_absoluteX="0dp">

        <ImageView
            android:layout_width="48sp"
            android:layout_height="48sp"
            android:src="@drawable/ic_status"
            tools:src="@drawable/ic_status" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloSituacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloSituacao" />

            <TextView
                android:id="@+id/txtViewValorSituacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Ativo"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutIngresso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutSituacao"
        tools:layout_editor_absoluteX="0dp">

        <ImageView
            android:layout_width="48sp"
            android:layout_height="48sp"
            android:src="@drawable/ic_ingresso"
            tools:src="@drawable/ic_ingresso" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloIngresso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloIngresso" />

            <TextView
                android:id="@+id/txtViewValorIngresso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2020.1"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnSairPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/btnSairPerfilText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutIngresso" />


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Imagem de perfil -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPerfil"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ifrs_poa_logo"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorPrimary"
        app:shapeAppearanceOverlay="@style/Circular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LinearLayout para nome -->
    <LinearLayout
        android:id="@+id/linearLayoutNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/imgPerfil">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_pessoa" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloNome" />

            <TextView
                android:id="@+id/txtViewValorNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leonardo Dias Goandete" />
        </LinearLayout>
    </LinearLayout>

    <!-- LinearLayout para matrícula -->
    <LinearLayout
        android:id="@+id/linearLayoutMatricula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutNome">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_matricula" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloMatricula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloMatricula" />

            <TextView
                android:id="@+id/txtViewValorMatricula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2020007666" />
        </LinearLayout>
    </LinearLayout>

    <!-- LinearLayout para curso -->
    <LinearLayout
        android:id="@+id/linearLayoutCurso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutMatricula">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_curso" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloCurso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloCurso" />

            <TextView
                android:id="@+id/txtViewValorCurso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TECNOLOGIA EM SISTEMAS PARA INTERNET/DE-POA - Porto Alegre - TECNOLÓGICO - MN" />
        </LinearLayout>
    </LinearLayout>

    <!-- LinearLayout para nível -->
    <LinearLayout
        android:id="@+id/linearLayoutNivel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutCurso">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_nivel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloNivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloNivel" />

            <TextView
                android:id="@+id/txtViewValorNivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Graduação" />
        </LinearLayout>
    </LinearLayout>

    <!-- LinearLayout para situação -->
    <LinearLayout
        android:id="@+id/linearLayoutSituacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutNivel">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_status" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloSituacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloSituacao" />

            <TextView
                android:id="@+id/txtViewValorSituacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ativo"/>
        </LinearLayout>
    </LinearLayout>

    <!-- LinearLayout para ingresso -->
    <LinearLayout
        android:id="@+id/linearLayoutIngresso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutSituacao">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_ingresso" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/txtTituloIngresso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="@string/txtViewTituloIngresso" />

            <TextView
                android:id="@+id/txtViewValorIngresso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2020.1"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Botão de sair -->
    <Button
        android:id="@+id/btnSairPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/btnSairPerfilText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutIngresso" />

</androidx.constraintlayout.widget.ConstraintLayout>
